# PostgreSQL（团队集成 / 部署）
DATABASE_URL=postgresql+psycopg://forgepilot:change-me@localhost:5432/forgepilot

# SQLite 本地演示（不设置 DATABASE_URL 时的默认值）
# DATABASE_URL=sqlite+pysqlite:///./forgepilot.db

# 允许的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 认证模式：demo（本地/评审）| token（生产演示，Bearer 签名令牌）
AUTH_MODE=demo
# token 模式必填，至少 32 字符随机值
AUTH_SECRET=change-me-to-a-random-secret
# 公开写入保护；设置后 POST/PATCH/PUT/DELETE 需要 X-Write-Key
WRITE_API_KEY=
# 生产建议 false，关闭 /docs、/redoc、/openapi.json
DOCS_ENABLED=true
