# 运行环境：production 时禁止 Mock LLM 与 static 设备提供方
APP_ENV=development

# 真实模型配置（可选；默认 LLM_PROVIDER=mock，无需以下变量）
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024
# 默认不读取系统代理，避免 token/密钥经过未知代理
HTTP_TRUST_ENV=false

# 设备事实提供方（默认 static 仅用于离线演示与测试）
DEVICE_PROVIDER=static
# DEVICE_PROVIDER=http
DEVICE_API_BASE_URL=
DEVICE_API_TIMEOUT=5
# 设备型号到知识库文档域的映射（可选 JSON，覆盖默认 GX11/P-102X/GMC-4000）
# DEVICE_KNOWLEDGE_MODELS={"GX11": "compressor-002"}
# 注意：组织/用户/token 不在环境变量中固定，按 /chat 请求头逐请求透传给 B 包。

# C 侧安全与运行配置
C_REQUIRE_AUTH=true
C_DEFAULT_ORGANIZATION_ID=demo-org
# 生产环境必填：B 服务地址，用 Bearer 令牌查询 /api/v1/auth/me 并校验组织/岗位
C_IDENTITY_API_BASE_URL=
# 生产环境应保持 false，仅在本地导入演示文档时临时开启
C_ENABLE_INGEST=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
# 请求体上限需大于上传上限（multipart 额外开销）
MAX_REQUEST_BYTES=6000000
MAX_UPLOAD_BYTES=5000000
DOCS_ENABLED=true
