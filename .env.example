# 真实模型配置（可选；默认 LLM_PROVIDER=mock，无需以下变量）
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=30

# 设备事实提供方（默认 static 仅用于离线演示与测试）
DEVICE_PROVIDER=static
# DEVICE_PROVIDER=http
DEVICE_API_BASE_URL=
DEVICE_API_TIMEOUT=5
# 设备型号到知识库文档域的映射（可选 JSON，覆盖默认 GX11/P-102X/GMC-4000）
# DEVICE_KNOWLEDGE_MODELS={"GX11": "compressor-002"}
# 注意：组织/用户/token 不在环境变量中固定，按 /chat 请求头逐请求透传给 B 包。
