# mock: use built-in demo data; api: request the configured backend
VITE_DATA_MODE=mock

# Example: http://localhost:8000
VITE_API_BASE_URL=

# Optional separate C RAG service during integration; defaults to API_BASE_URL.
# Public backend URL only. Never put model keys into VITE_ variables.
VITE_DIAGNOSIS_API_BASE_URL=

# Optional demo identity headers used by the current business backend.
# These are public demo identifiers, not passwords or API secrets.
VITE_API_ORGANIZATION_ID=demo-org
VITE_API_USER_ID=demo@example.com
