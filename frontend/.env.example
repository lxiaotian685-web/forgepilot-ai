# mock: local permission preview + built-in demo data
# api: require real login, then request the configured backend with Bearer token
VITE_DATA_MODE=mock

# Example: http://localhost:8000
VITE_API_BASE_URL=

# Optional separate B business service during integration; defaults to API_BASE_URL.
VITE_BUSINESS_API_BASE_URL=

# Required in API mode: separate C knowledge and diagnosis service.
# Public backend URL only. Never put model keys into VITE_ variables.
VITE_DIAGNOSIS_API_BASE_URL=

# Only used by local mock development where no login token exists.
VITE_API_ORGANIZATION_ID=demo-org
VITE_API_USER_ID=demo@example.com
